pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo '🛠️ Этап сборки: компилируем код (имитация)...'
                sh 'sleep 2' // Имитируем полезную работу
            }
        }
        stage('Test') {
            steps {
                echo '🧪 Этап тестирования: запускаем юнит-тесты (имитация)...'
                sh 'echo "Все тесты прошли успешно!"'
            }
        }
    }
}
