@Library('os-build-lib@feature/oop-architecture') _
import common.OSFactory

pipeline {
    agent any

    parameters {
        string(name: 'OS_TYPE')
        string(name: 'RELEASE_VERSION')
    }

    stages {
        stage('Analyze and Route') {
            steps {
                script {
                    echo "🧠 Оркестратор получил запрос на тестирование ${params.OS_TYPE}"
                    
                    // Создаем объект ОС
                    def os = OSFactory.createOS(params.OS_TYPE, [
                        releaseVersion: params.RELEASE_VERSION
                    ])
                    
                    // Используем метод класса для получения конфигурации тестов
                    def testConfig = os.getTestConfig(params.RELEASE_VERSION)
                    
                    echo "📖 Получены параметры из объекта ${os.class.simpleName}:"
                    echo "   - Test Suite: ${testConfig.testSuite}"
                    echo "   - Timeout: ${testConfig.timeout}"
                    
                    env.TEST_SUITE = testConfig.testSuite
                    env.TIMEOUT = testConfig.timeout
                }
            }
        }

        stage('Trigger Test Job') {
            steps {
                build job: 'Test/os-tests-sandbox', 
                      parameters: [
                          string(name: 'OS_TYPE', value: params.OS_TYPE),
                          string(name: 'RELEASE_VERSION', value: params.RELEASE_VERSION),
                          string(name: 'TEST_SUITE', value: env.TEST_SUITE),
                          string(name: 'TIMEOUT', value: env.TIMEOUT)
                      ],
                      wait: false
            }
        }
    }
}